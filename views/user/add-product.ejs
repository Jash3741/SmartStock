<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartStock - Add Product</title>
  <link rel="stylesheet" href="/css/add-product.css">
</head>
<body>

<div class="app">

  <!-- ================= SIDEBAR ================= -->
  <aside class="sidebar">

    <a href="/dashboard" class="brand">
      <span class="brand-mark">
        <i></i><i></i><i></i>
      </span>
      <span>Smart<span>Stock</span></span>
    </a>

    <button class="workspace">
      <span class="workspace-icon">▣</span>
      <span class="workspace-text">
        <strong>Northline Ops</strong>
        <small>4 locations</small>
      </span>
      <span class="workspace-arrow">⌄</span>
    </button>

    <nav class="navigation">

      <div class="nav-title">WORKSPACE</div>

      <a href="/<%= User._id %>/dashboard" class="nav-item">
        <span>▦</span>
        Dashboard
      </a>

      <a href="/products/add" class="nav-item active">
        <span>⊕</span>
        Add Product
      </a>

      <a href="/inventory" class="nav-item">
        <span>♧</span>
        Inventory
      </a>

      <a href="/sales" class="nav-item">
        <span>$</span>
        Sales
      </a>

      <a href="/reports" class="nav-item">
        <span>▥</span>
        Reports
      </a>

      <div class="nav-title manage-title">MANAGE</div>

      <a href="/suppliers" class="nav-item">
        <span>▱</span>
        Suppliers
      </a>

      <a href="/locations" class="nav-item">
        <span>⌖</span>
        Locations
      </a>

      <a href="/settings" class="nav-item">
        <span>⚙</span>
        Settings
      </a>
    </nav>

    <div class="sidebar-bottom">

      <div class="health-card">
        <div class="health-top">
          <span>Inventory health</span>
          <strong>92%</strong>
        </div>

        <div class="health-bar">
          <span></span>
        </div>

        <small>12,486 SKUs synced · 2m ago</small>
      </div>

      <a href="/profile" class="user">
        <div class="avatar">
          <%= typeof reqUser !== 'undefined' && reqUser?.username
              ? reqUser.username.substring(0, 2).toUpperCase()
              : 'TM' %>
        </div>

        <div class="user-info">
          <strong>
            <%= typeof reqUser !== 'undefined' && reqUser?.username
                ? reqUser.username
                : 'Taylor Morgan' %>
          </strong>
          <small>Operations admin</small>
        </div>

        <span class="online"></span>
      </a>

    </div>
  </aside>


  <!-- ================= MAIN CONTENT ================= -->
  <main class="main">

    <!-- Top bar -->
    <header class="topbar">

      <div class="search">
        <span class="search-icon">⌕</span>
        <input
          type="search"
          placeholder="Search products, SKUs, suppliers..."
        >
        <kbd>⌘ K</kbd>
      </div>

      <div class="top-actions">

        <div class="sync">
          <i></i>
          SYNCED NOW
        </div>

        <button class="circle-btn">?</button>

        <button class="circle-btn notification">
          ♧
          <i></i>
        </button>

        <button class="date-btn">
          ▣
          <span>Sep 1 – Sep 30</span>
          ⌄
        </button>

      </div>
    </header>


    <!-- Content -->
    <div class="content">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/<%= User._id %>/dashboard">Dashboard</a>
        <span>›</span>
        <strong>Add Product</strong>
      </div>


      <!-- Page title -->
      <div class="page-title">
        <div>
          <h1>Add Product</h1>
          <p>Add a new product and keep your inventory up to date.</p>
        </div>

        <a href="/products" class="back-btn">
          ← Back to inventory
        </a>
      </div>


      <!-- ================= PRODUCT FORM ================= -->
      <form
        action="/<%= User._id %>/products/new"
        method="POST"
        class="product-form"
      >

        <!-- Product Information -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon green">▣</div>

            <div>
              <h2>Product information</h2>
              <p>Basic details about the product.</p>
            </div>
          </div>

          <div class="form-grid">

            <div class="field field-full">
              <label for="productName">
                Product name <span>*</span>
              </label>

              <input
                type="text"
                id="productName"
                name="productName"
                placeholder="e.g. Wireless Sensor Module"
                required
              >
            </div>


            <div class="field">
              <label for="sku">
                SKU <span>*</span>
              </label>

              <input
                type="text"
                id="sku"
                name="sku"
                placeholder="e.g. SS-2041"
                required
              >
            </div>


            <div class="field">
              <label for="barcode">
                Barcode
              </label>

              <div class="input-action">
                <input
                  type="text"
                  id="barcode"
                  name="barcode"
                  placeholder="Scan or enter barcode"
                >

                <button
                  type="button"
                  class="generate-btn"
                  onclick="generateBarcode()"
                >
                  Generate
                </button>
              </div>

              <small class="help-text">
                Leave empty if you want to generate it later.
              </small>
            </div>


            <div class="field">
              <label for="categoryId">
                Category <span>*</span>
              </label>

              <div class="select-action-group">
                <select id="categoryId" name="categoryId" required>
                  <option value="" selected disabled>
                    Select Category
                  </option>
                  <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat._id %>"><%= cat.name %></option>
                    <% }); %>
                  <% } %>
                </select>

                <button
                  type="button"
                  class="add-inline-btn"
                  id="openCategoryModalBtn"
                >
                  + Add Category
                </button>
              </div>
            </div>


            <div class="field">
              <label for="supplier">
                Supplier
              </label>

              <select id="supplier" name="supplier">
                <option value="" selected>Select supplier</option>
                <option value="Vertex Industrial">Vertex Industrial</option>
                <option value="Aster Components">Aster Components</option>
                <option value="North Forge Co.">North Forge Co.</option>
                <option value="Circuit Supply">Circuit Supply</option>
              </select>
            </div>


            <div class="field field-full">
              <label for="description">
                Description
              </label>

              <textarea
                id="description"
                name="description"
                rows="4"
                placeholder="Write a short description of the product..."
              ></textarea>
            </div>

          </div>
        </section>


        <!-- Inventory -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon blue">♧</div>

            <div>
              <h2>Inventory</h2>
              <p>Set the initial stock and reorder settings.</p>
            </div>
          </div>

          <div class="form-grid three">


            <div class="field">
              <label for="unitId">
                Unit <span>*</span>
              </label>

              <div class="select-action-group">
                <select id="unitId" name="unitId" required>
                  <option value="" selected disabled>
                    Select Unit
                  </option>
                  <% if (typeof units !== 'undefined' && units.length > 0) { %>
                    <% units.forEach(function(u) { %>
                      <option value="<%= u._id %>"><%= u.name %> (<%= u.symbol %>)</option>
                    <% }); %>
                  <% } %>
                </select>

                <button
                  type="button"
                  class="add-inline-btn"
                  id="openUnitModalBtn"
                >
                  + Add Unit
                </button>
              </div>
            </div>

            <div class="field">
              <label for="quantity">
                Initial Stock / Quantity
              </label>

              <input
                type="number"
                id="quantity"
                name="quantity"
                min="0"
                placeholder="e.g. 50"
                value="0"
              >
            </div>

            <div class="field">
              <label for="reorderLevel">
                Reorder level
              </label>

              <input
                type="number"
                id="reorderLevel"
                name="reorderLevel"
                min="0"
                placeholder="e.g. 20"
              >
            </div>

            <div class="field">
              <label for="expiryDate">
                Expiry date
              </label>

              <input
                type="date"
                id="expiryDate"
                name="expiryDate"
              >
            </div>

          </div>
        </section>


        <!-- Pricing -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon orange">$</div>

            <div>
              <h2>Pricing</h2>
              <p>Set purchase and selling prices.</p>
            </div>
          </div>

          <div class="form-grid three">

            <div class="field">
              <label for="costPrice">
                Cost price
              </label>

              <div class="money-input">
                <span>₹</span>

                <input
                  type="number"
                  id="costPrice"
                  name="costPrice"
                  min="0"
                  step="0.01"
                  placeholder="0.00"
                >
              </div>
            </div>


            <div class="field">
              <label for="sellingPrice">
                Selling price <span>*</span>
              </label>

              <div class="money-input">
                <span>₹</span>

                <input
                  type="number"
                  id="sellingPrice"
                  name="sellingPrice"
                  min="0"
                  step="0.01"
                  placeholder="0.00"
                  required
                >
              </div>
            </div>


            <div class="field">
              <label for="tax">
                Tax / GST
              </label>

              <div class="suffix-input">
                <input
                  type="number"
                  id="tax"
                  name="tax"
                  min="0"
                  max="100"
                  step="0.01"
                  placeholder="18"
                >
                <span>%</span>
              </div>
            </div>

          </div>
        </section>


        <!-- Form actions -->
        <div class="form-actions">

          <a href="/products" class="cancel-btn">
            Cancel
          </a>

          <button type="submit" class="save-btn">
            <span>✓</span>
            Save Product
          </button>

        </div>

      </form>

    </div>
  </main>

</div>


<!-- ================= ADD CATEGORY MODAL ================= -->
<div class="modal-overlay" id="categoryModal" role="dialog" aria-modal="true" aria-labelledby="categoryModalTitle">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="categoryModalTitle">
        <span>▣</span> Add New Category
      </h3>
      <button type="button" class="modal-close-btn" id="closeCategoryModalBtn" aria-label="Close modal">&times;</button>
    </div>

    <form id="addCategoryForm" onsubmit="handleCategorySubmit(event)">
      <div class="modal-body">
        <div class="modal-error" id="categoryModalError"></div>

        <div class="field">
          <label for="newCategoryName">
            Category Name <span>*</span>
          </label>
          <input
            type="text"
            id="newCategoryName"
            name="name"
            placeholder="e.g. Electrical Tools"
            required
            autocomplete="off"
          >
        </div>

        <div class="field">
          <label for="newCategoryDescription">
            Description
          </label>
          <textarea
            id="newCategoryDescription"
            name="description"
            rows="3"
            placeholder="Short category description (optional)..."
          ></textarea>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="cancel-btn" id="cancelCategoryBtn">
          Cancel
        </button>
        <button type="submit" class="save-btn" id="saveCategoryBtn">
          <span class="btn-text">Save Category</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= ADD UNIT MODAL ================= -->
<div class="modal-overlay" id="unitModal" role="dialog" aria-modal="true" aria-labelledby="unitModalTitle">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="unitModalTitle">
        <span>♧</span> Add New Unit
      </h3>
      <button type="button" class="modal-close-btn" id="closeUnitModalBtn" aria-label="Close modal">&times;</button>
    </div>

    <form id="addUnitForm" onsubmit="handleUnitSubmit(event)">
      <div class="modal-body">
        <div class="modal-error" id="unitModalError"></div>

        <div class="field">
          <label for="newUnitName">
            Unit Name <span>*</span>
          </label>
          <input
            type="text"
            id="newUnitName"
            name="name"
            placeholder="e.g. Kilogram"
            required
            autocomplete="off"
          >
        </div>

        <div class="field">
          <label for="newUnitSymbol">
            Unit Symbol <span>*</span>
          </label>
          <input
            type="text"
            id="newUnitSymbol"
            name="symbol"
            placeholder="e.g. kg"
            required
            autocomplete="off"
          >
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="cancel-btn" id="cancelUnitBtn">
          Cancel
        </button>
        <button type="submit" class="save-btn" id="saveUnitBtn">
          <span class="btn-text">Save Unit</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function generateBarcode() {
    const barcode = document.getElementById("barcode");
    if (barcode.value.trim() !== "") {
      return;
    }
    const randomBarcode =
      "890" + Math.floor(100000000 + Math.random() * 900000000);
    barcode.value = randomBarcode;
  }

  // DOM Elements
  const categorySelect = document.getElementById("categoryId");
  const unitSelect = document.getElementById("unitId");

  const categoryModal = document.getElementById("categoryModal");
  const openCategoryModalBtn = document.getElementById("openCategoryModalBtn");
  const closeCategoryModalBtn = document.getElementById("closeCategoryModalBtn");
  const cancelCategoryBtn = document.getElementById("cancelCategoryBtn");
  const categoryModalError = document.getElementById("categoryModalError");
  const newCategoryName = document.getElementById("newCategoryName");
  const newCategoryDescription = document.getElementById("newCategoryDescription");
  const saveCategoryBtn = document.getElementById("saveCategoryBtn");

  const unitModal = document.getElementById("unitModal");
  const openUnitModalBtn = document.getElementById("openUnitModalBtn");
  const closeUnitModalBtn = document.getElementById("closeUnitModalBtn");
  const cancelUnitBtn = document.getElementById("cancelUnitBtn");
  const unitModalError = document.getElementById("unitModalError");
  const newUnitName = document.getElementById("newUnitName");
  const newUnitSymbol = document.getElementById("newUnitSymbol");
  const saveUnitBtn = document.getElementById("saveUnitBtn");

  // Category Modal Handlers
  function openCategoryModal() {
    categoryModalError.textContent = "";
    categoryModalError.classList.remove("visible");
    newCategoryName.value = "";
    newCategoryDescription.value = "";
    categoryModal.classList.add("active");
    setTimeout(() => newCategoryName.focus(), 50);
  }

  function closeCategoryModal() {
    categoryModal.classList.remove("active");
  }

  openCategoryModalBtn.addEventListener("click", openCategoryModal);
  closeCategoryModalBtn.addEventListener("click", closeCategoryModal);
  cancelCategoryBtn.addEventListener("click", closeCategoryModal);

  // Unit Modal Handlers
  function openUnitModal() {
    unitModalError.textContent = "";
    unitModalError.classList.remove("visible");
    newUnitName.value = "";
    newUnitSymbol.value = "";
    unitModal.classList.add("active");
    setTimeout(() => newUnitName.focus(), 50);
  }

  function closeUnitModal() {
    unitModal.classList.remove("active");
  }

  openUnitModalBtn.addEventListener("click", openUnitModal);
  closeUnitModalBtn.addEventListener("click", closeUnitModal);
  cancelUnitBtn.addEventListener("click", closeUnitModal);

  // Close modals on clicking overlay outside card
  categoryModal.addEventListener("click", (e) => {
    if (e.target === categoryModal) closeCategoryModal();
  });

  unitModal.addEventListener("click", (e) => {
    if (e.target === unitModal) closeUnitModal();
  });

  // Close modals on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeCategoryModal();
      closeUnitModal();
    }
  });

  // Handle Add Category submission
  async function handleCategorySubmit(e) {
    e.preventDefault();
    const name = newCategoryName.value.trim();
    const description = newCategoryDescription.value.trim();

    if (!name) {
      categoryModalError.textContent = "Category name is required.";
      categoryModalError.classList.add("visible");
      newCategoryName.focus();
      return;
    }

    categoryModalError.textContent = "";
    categoryModalError.classList.remove("visible");

    // Loading state
    const originalBtnHtml = saveCategoryBtn.innerHTML;
    saveCategoryBtn.disabled = true;
    saveCategoryBtn.innerHTML = '<span class="btn-spinner"></span> Saving...';

    try {
      const response = await fetch("/categories", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify({ name, description })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Failed to create category");
      }

      const category = data.category;

      // Add to select and select it
      const option = new Option(category.name, category._id);
      categorySelect.add(option);
      categorySelect.value = category._id;

      closeCategoryModal();
    } catch (err) {
      categoryModalError.textContent = err.message || "Error saving category";
      categoryModalError.classList.add("visible");
    } finally {
      saveCategoryBtn.disabled = false;
      saveCategoryBtn.innerHTML = originalBtnHtml;
    }
  }

  // Handle Add Unit submission
  async function handleUnitSubmit(e) {
    e.preventDefault();
    const name = newUnitName.value.trim();
    const symbol = newUnitSymbol.value.trim();

    if (!name) {
      unitModalError.textContent = "Unit name is required.";
      unitModalError.classList.add("visible");
      newUnitName.focus();
      return;
    }

    if (!symbol) {
      unitModalError.textContent = "Unit symbol is required.";
      unitModalError.classList.add("visible");
      newUnitSymbol.focus();
      return;
    }

    unitModalError.textContent = "";
    unitModalError.classList.remove("visible");

    // Loading state
    const originalBtnHtml = saveUnitBtn.innerHTML;
    saveUnitBtn.disabled = true;
    saveUnitBtn.innerHTML = '<span class="btn-spinner"></span> Saving...';

    try {
      const response = await fetch("/units", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify({ name, symbol })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Failed to create unit");
      }

      const unit = data.unit;

      // Add to select and select it
      const option = new Option(
        `${unit.name} (${unit.symbol})`,
        unit._id
      );
      unitSelect.add(option);
      unitSelect.value = unit._id;

      closeUnitModal();
    } catch (err) {
      unitModalError.textContent = err.message || "Error saving unit";
      unitModalError.classList.add("visible");
    } finally {
      saveUnitBtn.disabled = false;
      saveUnitBtn.innerHTML = originalBtnHtml;
    }
  }
</script>

</body>
</html>

