<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartStock – Add Product</title>
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/add-product.css">
</head>
<body>
  <!-- ================= SIDEBAR ================= -->
 <%- include("../layout/sidebar.ejs") %>

    <!-- Content -->
    <div class="content">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/<%= User._id %>/dashboard">Dashboard</a>
        <span>›</span>
        <a href="/inventory">Inventory</a>
        <span>›</span>
        <strong>Add Product</strong>
      </div>


      <!-- Page title -->
      <div class="page-title">
        <div>
          <h1>Add Product</h1>
          <p>Register a new product. Stock is added via Purchase entries.</p>
        </div>

        <a href="/inventory" class="back-btn">
          ← Back to Inventory
        </a>
      </div>


      <!-- ================= PRODUCT FORM ================= -->
      <form
        action="/<%= User._id %>/products/new"
        method="POST"
        class="product-form"
        id="productForm"
      >

        <!-- ─── SECTION 1: Product Details ─── -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon green">▣</div>
            <div>
              <h2>Product Details</h2>
              <p>Basic identification info about the product.</p>
            </div>
          </div>

          <div class="form-grid two-col">

            <!-- Product Name -->
            <div class="field field-full">
              <label for="productName">
                Product Name <span>*</span>
              </label>
              <input
                type="text"
                id="productName"
                name="productName"
                placeholder="e.g. Paracetamol 500mg Tablet"
                required
                autocomplete="off"
              >
            </div>

            <!-- Category -->
            <div class="field">
              <label for="categoryId">
                Category <span>*</span>
              </label>
              <div class="input-row">
                <select id="categoryId" name="categoryId" required>
                  <option value="" disabled selected>Select category</option>
                  <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat._id %>"><%= cat.name %></option>
                    <% }); %>
                  <% } %>
                </select>
                <button type="button" class="ghost-btn" id="openCategoryModalBtn">+ Add</button>
              </div>
            </div>

            <!-- Supplier -->
            <div class="field">
              <label for="supplierId">
                Default Supplier
              </label>
              <select id="supplierId" name="supplierId">
                <option value="">None / Not specified</option>
                <% if (typeof suppliers !== 'undefined' && suppliers.length > 0) { %>
                  <% suppliers.forEach(function(sup) { %>
                    <option value="<%= sup._id %>"><%= sup.name %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Description -->
            <div class="field field-full">
              <label for="description">Description</label>
              <textarea
                id="description"
                name="description"
                rows="3"
                placeholder="Short description, composition, usage notes..."
              ></textarea>
            </div>

          </div>
        </section>


        <!-- ─── SECTION 2: Identification ─── -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon purple">⊞</div>
            <div>
              <h2>Identification</h2>
              <p>SKU, barcode and product status.</p>
            </div>
          </div>

          <div class="form-grid three-col">

            <!-- SKU -->
            <div class="field">
              <label for="sku">SKU</label>
              <input
                type="text"
                id="sku"
                name="sku"
                placeholder="Auto-generated if empty"
                autocomplete="off"
              >
              <small class="help-text">Leave blank to auto-generate.</small>
            </div>

            <!-- Barcode -->
            <div class="field">
              <label for="barcode">Barcode</label>
              <div class="input-row">
                <input
                  type="text"
                  id="barcode"
                  name="barcode"
                  placeholder="Scan or type barcode"
                  autocomplete="off"
                >
              </div>
               <small class="help-text">Leave blank to auto-generate.</small>
            </div>

            <!-- Status -->
            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status">
                <option value="active" selected>Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </div>

          </div>
        </section>


        <!-- ─── SECTION 3: Pricing & Tax ─── -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon orange">₹</div>
            <div>
              <h2>Pricing &amp; Tax</h2>
              <p>Purchase price, selling price, and GST rate.</p>
            </div>
          </div>

          <div class="form-grid three-col">

            <!-- Purchase Price -->
            <div class="field">
              <label for="costPrice">Purchase / Cost Price</label>
              <div class="money-input">
                <span>₹</span>
                <input
                  type="number"
                  id="costPrice"
                  name="costPrice"
                  min="0"
                  step="0.01"
                  placeholder="0.00"
                  oninput="calcMargin()"
                >
              </div>
            </div>

            <!-- Selling Price -->
            <div class="field">
              <label for="sellingPrice">
                Selling Price <span>*</span>
              </label>
              <div class="money-input">
                <span>₹</span>
                <input
                  type="number"
                  id="sellingPrice"
                  name="sellingPrice"
                  min="0"
                  step="0.01"
                  placeholder="0.00"
                  required
                  oninput="calcMargin()"
                >
              </div>
              <!-- Live margin badge -->
              <div id="marginBadge" class="margin-badge" style="display:none;"></div>
            </div>

            <!-- GST -->
            <div class="field">
              <label>GST / Tax Rate</label>
              <!-- Quick preset chips -->
              <div class="gst-chips">
                <button type="button" class="gst-chip" data-val="0">0%</button>
                <button type="button" class="gst-chip" data-val="5">5%</button>
                <button type="button" class="gst-chip" data-val="12">12%</button>
                <button type="button" class="gst-chip active" data-val="18">18%</button>
                <button type="button" class="gst-chip" data-val="28">28%</button>
              </div>
              <div class="suffix-input" style="margin-top:8px;">
                <input
                  type="number"
                  id="tax"
                  name="tax"
                  min="0"
                  max="100"
                  step="0.01"
                  value="18"
                  placeholder="18"
                >
                <span>%</span>
              </div>
            </div>

          </div>
        </section>


        <!-- ─── SECTION 4: Stock & Reorder ─── -->
        <section class="form-card">

          <div class="card-heading">
            <div class="heading-icon blue">♧</div>
            <div>
              <h2>Stock &amp; Reorder Settings</h2>
              <p>Reorder level for low-stock alerts. Stock is managed via Purchases.</p>
            </div>
          </div>

          <div class="form-grid two-col">

            <!-- Reorder Level -->
            <div class="field">
              <label for="reorderLevel">Reorder Level (Min Stock Alert)</label>
              <input
                type="number"
                id="reorderLevel"
                name="reorderLevel"
                min="0"
                placeholder="e.g. 20"
              >
              <small class="help-text">Alert is triggered when stock falls below this.</small>
            </div>

            <!-- Note about initial stock -->
            <div class="field info-note">
              <div class="info-note-icon">ℹ</div>
              <div>
                <strong>Initial stock is 0</strong>
                <p>Stock quantities are managed exclusively through <a href="/purchases/new">Purchase Entries</a>. This keeps inventory accurate and fully traceable.</p>
              </div>
            </div>

          </div>
        </section>


        <!-- ─── Form Actions ─── -->
        <div class="form-actions">
          <a href="/inventory" class="cancel-btn">Cancel</a>
          <button type="submit" class="save-btn" id="submitBtn">
            <span>✓</span>
            Save Product
          </button>
        </div>

      </form>

    </div>
  </main>

</div>


<!-- ================= ADD CATEGORY MODAL ================= -->
<div class="modal-overlay" id="categoryModal" role="dialog" aria-modal="true" aria-labelledby="categoryModalTitle">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="categoryModalTitle">
        <span>▣</span> Add New Category
      </h3>
      <button type="button" class="modal-close-btn" id="closeCategoryModalBtn" aria-label="Close">&times;</button>
    </div>

    <form id="addCategoryForm" onsubmit="handleCategorySubmit(event)">
      <div class="modal-body">
        <div class="modal-error" id="categoryModalError"></div>

        <div class="field">
          <label for="newCategoryName">Category Name <span>*</span></label>
          <input type="text" id="newCategoryName" name="name" placeholder="e.g. Antibiotics" required autocomplete="off">
        </div>

        <div class="field">
          <label for="newCategoryDescription">Description</label>
          <textarea id="newCategoryDescription" name="description" rows="3" placeholder="Short description (optional)..."></textarea>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="cancel-btn" id="cancelCategoryBtn">Cancel</button>
        <button type="submit" class="save-btn" id="saveCategoryBtn">
          <span class="btn-text">Save Category</span>
        </button>
      </div>
    </form>
  </div>
</div>


<script>
  /* ===================================================
     BARCODE GENERATOR
  =================================================== */
  function generateBarcode() {
    const input = document.getElementById('barcode');
    // Only generate if empty
    if (input.value.trim() !== '') {
      showBarcodePreview(input.value.trim());
      return;
    }
    const code = '890' + Math.floor(100000000 + Math.random() * 900000000);
    input.value = code;
    showBarcodePreview(code);
  }

  // Simple EAN-like preview using thin/thick bars (visual only)
  function showBarcodePreview(code) {
    const preview = document.getElementById('barcodePreview');
    if (!code) { preview.style.display = 'none'; return; }

    // Build a simple visual barcode from character codes
    let bars = '';
    for (let i = 0; i < code.length; i++) {
      const w = (code.charCodeAt(i) % 3) + 1;
      const isWhite = i % 2 === 1;
      bars += `<span style="
        display:inline-block;
        width:${w * 3}px;
        height:48px;
        background:${isWhite ? '#fff' : '#1a2940'};
      "></span>`;
    }

    preview.innerHTML = `
      <div style="background:#fff;padding:10px 14px 6px;border-radius:6px;border:1px solid #e0e8f0;display:inline-flex;flex-direction:column;align-items:center;gap:4px;">
        <div style="display:flex;align-items:flex-end;gap:1px;">${bars}</div>
        <div style="font-size:10px;color:#555;letter-spacing:2px;font-family:monospace;">${code}</div>
      </div>`;
    preview.style.display = 'block';
  }

  // Auto-preview if barcode field is filled on load
  document.getElementById('barcode').addEventListener('input', function () {
    if (this.value.trim()) showBarcodePreview(this.value.trim());
    else document.getElementById('barcodePreview').style.display = 'none';
  });


  /* ===================================================
     LIVE MARGIN BADGE
  =================================================== */
  function calcMargin() {
    const cost   = parseFloat(document.getElementById('costPrice').value) || 0;
    const sell   = parseFloat(document.getElementById('sellingPrice').value) || 0;
    const badge  = document.getElementById('marginBadge');

    if (sell <= 0) { badge.style.display = 'none'; return; }

    const margin = ((sell - cost) / sell * 100).toFixed(1);
    const profit = (sell - cost).toFixed(2);
    const isPos  = (sell - cost) >= 0;

    badge.textContent = `Margin: ${margin}%  |  Profit: ₹${profit}`;
    badge.className   = 'margin-badge ' + (isPos ? 'margin-pos' : 'margin-neg');
    badge.style.display = 'inline-flex';
  }


  /* ===================================================
     GST PRESET CHIPS
  =================================================== */
  const chips  = document.querySelectorAll('.gst-chip');
  const gstInput = document.getElementById('tax');

  chips.forEach(chip => {
    chip.addEventListener('click', function () {
      chips.forEach(c => c.classList.remove('active'));
      this.classList.add('active');
      gstInput.value = this.dataset.val;
    });
  });

  // Sync chip highlight if user types in the input
  gstInput.addEventListener('input', function () {
    chips.forEach(c => {
      c.classList.toggle('active', c.dataset.val === this.value);
    });
  });


  /* ===================================================
     CATEGORY MODAL
  =================================================== */
  const categorySelect         = document.getElementById('categoryId');
  const categoryModal          = document.getElementById('categoryModal');
  const openCategoryModalBtn   = document.getElementById('openCategoryModalBtn');
  const closeCategoryModalBtn  = document.getElementById('closeCategoryModalBtn');
  const cancelCategoryBtn      = document.getElementById('cancelCategoryBtn');
  const categoryModalError     = document.getElementById('categoryModalError');
  const newCategoryName        = document.getElementById('newCategoryName');
  const newCategoryDescription = document.getElementById('newCategoryDescription');
  const saveCategoryBtn        = document.getElementById('saveCategoryBtn');

  function openCategoryModal() {
    categoryModalError.textContent = '';
    categoryModalError.classList.remove('visible');
    newCategoryName.value = '';
    newCategoryDescription.value = '';
    categoryModal.classList.add('active');
    setTimeout(() => newCategoryName.focus(), 60);
  }

  function closeCategoryModal() {
    categoryModal.classList.remove('active');
  }

  openCategoryModalBtn.addEventListener('click', openCategoryModal);
  closeCategoryModalBtn.addEventListener('click', closeCategoryModal);
  cancelCategoryBtn.addEventListener('click', closeCategoryModal);

  categoryModal.addEventListener('click', e => {
    if (e.target === categoryModal) closeCategoryModal();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeCategoryModal();
  });

  async function handleCategorySubmit(e) {
    e.preventDefault();
    const name        = newCategoryName.value.trim();
    const description = newCategoryDescription.value.trim();

    if (!name) {
      categoryModalError.textContent = 'Category name is required.';
      categoryModalError.classList.add('visible');
      newCategoryName.focus();
      return;
    }

    categoryModalError.textContent = '';
    categoryModalError.classList.remove('visible');

    const origHtml = saveCategoryBtn.innerHTML;
    saveCategoryBtn.disabled = true;
    saveCategoryBtn.innerHTML = '<span class="btn-spinner"></span> Saving...';

    try {
      const res  = await fetch('/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ name, description })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to create category');

      const option = new Option(data.category.name, data.category._id);
      categorySelect.add(option);
      categorySelect.value = data.category._id;

      closeCategoryModal();
    } catch (err) {
      categoryModalError.textContent = err.message || 'Error saving category';
      categoryModalError.classList.add('visible');
    } finally {
      saveCategoryBtn.disabled = false;
      saveCategoryBtn.innerHTML = origHtml;
    }
  }


  /* ===================================================
     FORM SUBMIT — LOADING STATE
  =================================================== */
  document.getElementById('productForm').addEventListener('submit', function () {
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="btn-spinner"></span> Saving...';
  });
</script>

</body>
</html>
